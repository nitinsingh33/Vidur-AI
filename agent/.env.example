# Base URL of the NestJS backend.
BACKEND_URL="http://localhost:3000"

# Base URL of this service's own FastAPI process (ML inference lives here too).
ML_SERVICE_URL="http://localhost:8001"

# Google Gemini API key used only to generate human-readable case narration.
# The recovery/policy/execution path never depends on this — see
# app/llm/diagnosis.py and app/graph/workflow.py::diagnose_case.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Shared secret sent to the backend's agent-facing endpoints (recovery cases,
# policy checks, escalation) via the x-agent-token header. Must match
# AGENT_SERVICE_TOKEN in backend/.env exactly.
AGENT_SERVICE_TOKEN=""
