# Base URL of the NestJS backend.
BACKEND_URL="http://localhost:3000"

# Base URL of this service's own FastAPI process (ML inference lives here too).
ML_SERVICE_URL="http://localhost:8001"

# Google Gemini API key used only to generate human-readable case narration.
# The recovery/policy/execution path never depends on this — see
# app/llm/diagnosis.py and app/graph/workflow.py::diagnose_case.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.6-flash"

# Used only when GEMINI_MODEL is rate-limited (429) on every retry — one
# further attempt goes to this smaller, separately-quota'd model so a
# diagnosis still has a chance to generate. Same best-effort contract.
GEMINI_FALLBACK_MODEL="gemini-2.5-flash-lite"

# Text-to-speech-capable Gemini model, used only for the Hinglish voice
# message recovery channel (see app/llm/voice_message.py). Same best-effort
# contract as GEMINI_MODEL above — a bad/missing value just means that one
# channel fails gracefully, never blocking the deterministic pipeline.
GEMINI_TTS_MODEL="gemini-2.5-flash-preview-tts"

# Shared secret sent to the backend's agent-facing endpoints (recovery cases,
# policy checks, escalation) via the x-agent-token header. Must match
# AGENT_SERVICE_TOKEN in backend/.env exactly.
AGENT_SERVICE_TOKEN=""
