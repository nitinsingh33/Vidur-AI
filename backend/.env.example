# PostgreSQL connection string used by Prisma. For local dev, run
# `docker compose up -d` from the repo root and use the credentials below.
# NOTE: mapped to host port 5433 (not 5432) to avoid clashing with any
# native/other local Postgres install already using 5432.
DATABASE_URL="postgresql://recoverai:recoverai@localhost:5433/recoverai"

# Base URL of the ML/agent FastAPI service (agent/).
ML_SERVICE_URL="http://localhost:8001"

# Redis connection string (BullMQ queues). Local dev: docker-compose redis.
REDIS_URL="redis://localhost:6379"

# Checkout abandonment: how long (minutes) an Order can sit unpaid before
# the scheduled sweep treats it as abandoned rather than mid-checkout, and
# how often (minutes) the sweep runs. Both default sensibly if unset.
CHECKOUT_ABANDONMENT_GRACE_MINUTES="20"
CHECKOUT_SWEEP_INTERVAL_MINUTES="5"

# Razorpay API credentials (Test Mode key/secret from the Razorpay dashboard).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Secret configured for the Razorpay webhook (Dashboard > Settings > Webhooks).
# Used to verify X-Razorpay-Signature on incoming payment.failed events.
RAZORPAY_WEBHOOK_SECRET=""

# Resend API key used to send recovery emails.
RESEND_API_KEY=""

# Secret used to sign/verify merchant JWTs. Use a long random value in production.
JWT_SECRET=""

# Shared secret the Python agent presents (via the x-agent-token header) to call
# the recovery/policy/escalation endpoints without a merchant JWT. Must match
# AGENT_SERVICE_TOKEN in agent/.env exactly.
AGENT_SERVICE_TOKEN=""

# Optional: only needed if using Neon (not local docker-compose Postgres).
# NEON_BRANCH="production"
# DATABASE_URL_UNPOOLED=""
# NEON_AI_GATEWAY_TOKEN=""
# NEON_AI_GATEWAY_BASE_URL=""
