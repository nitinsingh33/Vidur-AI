generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum MerchantUserRole {
  ADMIN
  OPERATOR
  FINANCE_MANAGER
}

enum OrderStatus {
  CREATED
  PAID
  FAILED
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD
  UPI
  NETBANKING
  WALLET
  EMI
  OTHER
}

enum PaymentEventType {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  RETRY_STARTED
  RETRY_FAILED
  RETRY_SUCCEEDED
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
  EXPIRED
  PAYMENT_FAILED
}

enum MandateStatus {
  CREATED
  CONFIRMED
  REJECTED
  PAUSED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum RecoveryCaseStatus {
  OPEN
  ELIGIBLE
  IN_PROGRESS
  RECOVERED
  EXHAUSTED
  ESCALATED
  STOPPED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RecoveryActionType {
  RETRY_PAYMENT
  SEND_PAYMENT_LINK
  SEND_EMAIL
  SEND_WHATSAPP
  UPDATE_PAYMENT_METHOD
  FOLLOW_UP_RECEIVABLE
  /// A real, AI-generated Hinglish voice message (see RecoveryService.
  /// sendVoiceMessage and the agent's /generate-voice-message endpoint) —
  /// never a placed phone call. Selected as a channel-escalation step after
  /// repeated SEND_PAYMENT_LINK/RETRY_PAYMENT attempts, before ESCALATE_HUMAN.
  SEND_VOICE_MESSAGE
  ESCALATE_HUMAN
  STOP_RECOVERY
}

enum RecoveryActionStatus {
  PENDING
  APPROVED
  BLOCKED
  EXECUTING
  SUCCESS
  FAILED
}

enum PolicyAction {
  ALLOW
  BLOCK
  REQUIRE_APPROVAL
}

enum RecoveryBatchStatus {
  DETECTED
  RUNNING
  COMPLETED
}

enum PromiseStatus {
  PENDING
  KEPT
  MISSED
}

model Merchant {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  currency  String   @default("INR")
  /// Public storefront identifier (e.g. "fashionkart"). Null for merchants
  /// that don't have a customer-facing storefront configured.
  slug      String?  @unique
  /// Razorpay Key ID — not secret (used client-side by Checkout.js already),
  /// stored in plaintext. Null means this merchant has not connected their
  /// own Razorpay account and transacts through Vidur's shared sandbox
  /// account (RAZORPAY_KEY_ID/SECRET env vars) — see RazorpayService.
  razorpayKeyId String?
  /// AES-256-GCM encrypted Razorpay Key Secret. Never returned by any API
  /// response — decrypted only inside RazorpayService/CredentialEncryptionService
  /// at the moment of calling the Razorpay API.
  razorpayKeySecretEncrypted String?
  /// AES-256-GCM encrypted webhook secret for this merchant's own
  /// /razorpay/webhook/merchant/:merchantId route. Never returned by any API
  /// response.
  razorpayWebhookSecretEncrypted String?
  /// True only for the dedicated FashionKart demo tenant (set by
  /// seed-fashionkart.ts). Gates two things: which merchant's transactional
  /// data may ever be tagged isDemoData at creation time, and which
  /// merchant FashionKartDemoResetService will operate on at all — a
  /// belt-and-suspenders check independent of the ADMIN-role/JWT check on
  /// the reset endpoint itself.
  isDemoMerchant Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          MerchantUser[]
  customers      Customer[]
  orders         Order[]
  payments       Payment[]
  subscriptions  Subscription[]
  mandates       Mandate[]
  invoices       Invoice[]
  products       Product[]
  recoveryCases  RecoveryCase[]
  recoveryBatches RecoveryBatch[]
  policies       Policy[]
  auditLogs      AuditLog[]
  promisesToPay  PromiseToPay[]
}

/**
 * A storefront product for the merchant's public storefront (e.g.
 * FashionKart). Purely a catalog/display concern — checkout still creates a
 * flat-amount Order the same way every other checkout path does; Order
 * itself carries no line-item relations, only a human-readable
 * itemsSummary snapshot (see Order below).
 */
model Product {
  id          String   @id @default(uuid())
  merchantId  String
  name        String
  description String?
  imageUrl    String?
  priceAmount Decimal  @db.Decimal(18, 2)
  currency    String   @default("INR")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model MerchantUser {
  id           String           @id @default(uuid())
  merchantId   String
  name         String
  email        String           @unique
  passwordHash String
  role         MerchantUserRole
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
}

model Customer {
  id         String    @id @default(uuid())
  merchantId String
  externalId String?
  /// Razorpay customer id (cust_...). Required by the recurring-payments
  /// (mandate) APIs, which key everything off a Razorpay customer rather
  /// than an order/payment's notes. Created lazily on first mandate
  /// registration for this customer, not at Customer-creation time.
  razorpayCustomerId String?
  name       String
  email      String?
  phone      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  invoice    Invoice[]

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders        Order[]
  payments      Payment[]
  subscriptions Subscription[]
  mandates      Mandate[]
  recoveryCases RecoveryCase[]
  promisesToPay PromiseToPay[]

  @@unique([merchantId, externalId])
  @@index([merchantId])
  @@index([email])
}

model Order {
  id         String      @id @default(uuid())
  merchantId String
  customerId String?
  /// Razorpay order id (e.g. order_...) for the order created via
  /// /razorpay/checkout. Lets webhooks (payment.failed, payment.captured,
  /// order.paid) find their way back to this internal Order row.
  externalId String?
  /// Set when this order is a mandate debit attempt (registration or a
  /// recurring re-presentment) rather than a one-off checkout order — lets
  /// a failed Payment on this order be traced back to the Mandate that
  /// authorized it, so RecoveryService knows to retry it headlessly via the
  /// stored token instead of sending a payment link.
  mandateId  String?
  /// Human-readable snapshot of the cart at checkout time (e.g. "2x Classic
  /// Tee, 1x Denim Jacket") for a storefront order — display only, never
  /// used to compute the amount actually charged.
  itemsSummary String?
  /// Set by a real browser signal (tab close/hide) sent from the storefront
  /// checkout page before payment completed — lets the checkout-abandonment
  /// sweep treat this order as abandoned immediately instead of waiting out
  /// the full grace period. Null means no such signal was received; the
  /// sweep still catches it later via the grace-period cutoff either way.
  abandonSignalAt DateTime?
  /// Set only when this Order was created for the dedicated FashionKart
  /// demo tenant (RazorpayService.createCheckoutOrder /
  /// RecoveryLabService), never client-settable. Lets
  /// FashionKartDemoResetService find exactly the rows it's allowed to
  /// delete — defaults false, so every pre-existing Order is automatically
  /// excluded.
  isDemoData Boolean     @default(false)
  amount     Decimal     @db.Decimal(18, 2)
  currency   String      @default("INR")
  status     OrderStatus @default(CREATED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  merchant Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  mandate  Mandate?  @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  payments Payment[]
  recoveryCases RecoveryCase[]

  @@unique([merchantId, externalId])
  @@index([merchantId])
  @@index([mandateId])
  @@index([customerId])
  @@index([status])
  @@index([externalId])
}

model Payment {
  id            String        @id @default(uuid())
  merchantId    String
  customerId    String?
  orderId       String?
  amount        Decimal       @db.Decimal(18, 2)
  currency      String        @default("INR")
  method        PaymentMethod
  status        PaymentStatus @default(CREATED)
  failureReason String?
  attemptNumber Int           @default(1)
  externalId    String?
  /// See Order.isDemoData — set only for a standalone demo Payment (one
  /// with no orderId, e.g. Recovery Lab's payment-degradation scenario).
  /// An order-linked demo payment is found transitively via its Order
  /// instead, so this stays false for those.
  isDemoData    Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer      Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  order         Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  events        PaymentEvent[]
  recoveryCases RecoveryCase[]

  @@unique([merchantId, externalId])
  @@index([merchantId])
  @@index([customerId])
  @@index([orderId])
  @@index([status])
}

model PaymentEvent {
  id         String           @id @default(uuid())
  paymentId  String
  type       PaymentEventType
  reason     String?
  metadata   Json?
  occurredAt DateTime         @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([type])
  @@index([occurredAt])
}

model Subscription {
  id                 String             @id @default(uuid())
  merchantId         String
  customerId         String
  /// Razorpay subscription id (e.g. sub_...). Lets webhooks (subscription.
  /// charged/pending/halted), which carry no merchant JWT, find their way
  /// back to this internal Subscription row.
  externalId         String?
  amount             Decimal            @db.Decimal(18, 2)
  currency           String             @default("INR")
  status             SubscriptionStatus @default(ACTIVE)
  nextBillingAt      DateTime?
  failedPaymentCount Int                @default(0)
  /// See Order.isDemoData.
  isDemoData         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recoveryCases RecoveryCase[]

  @@unique([merchantId, externalId])
  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([externalId])
}

model Mandate {
  id         String        @id @default(uuid())
  merchantId String
  customerId String
  /// Razorpay token id (token_...), set once token.confirmed fires —
  /// this is what future recurring debits are charged against.
  externalId String?
  /// Razorpay order id used for the original authorization payment. Known
  /// immediately at registration time (before the token exists), so
  /// token.confirmed/rejected webhooks — which carry no merchant JWT — can
  /// correlate back to this row via the authorization payment's order id.
  registrationOrderId String
  /// Razorpay payment method used for authorization: 'upi' (UPI Autopay)
  /// or 'emandate' (NACH/net-banking-authorized recurring debit).
  method     String        @default("upi")
  maxAmount  Decimal       @db.Decimal(18, 2)
  currency   String        @default("INR")
  frequency  String        @default("monthly")
  status     MandateStatus @default(CREATED)
  expireAt   DateTime?
  /// Consecutive failed re-presentments since the last successful debit —
  /// resets to 0 on a successful charge. Distinct from RecoveryAction
  /// attempt counts: this drives the NPCI-style retry ceiling, not the
  /// generic per-case action limit.
  failedDebitCount Int      @default(0)
  /// When the last debit (registration or retry) was actually attempted —
  /// enforces a minimum gap between re-presentments, since Razorpay (unlike
  /// Subscriptions) does not auto-retry a failed mandate debit itself.
  lastAttemptAt    DateTime?
  /// See Order.isDemoData.
  isDemoData Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders        Order[]
  recoveryCases RecoveryCase[]

  @@unique([merchantId, externalId])
  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([registrationOrderId])
}

model Invoice {
  id         String        @id @default(uuid())
  merchantId String
  customerId String
  amount     Decimal       @db.Decimal(18, 2)
  currency   String        @default("INR")
  status     InvoiceStatus @default(ISSUED)
  dueDate    DateTime
  paidAt     DateTime?
  /// See Order.isDemoData.
  isDemoData Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  merchant      Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer      Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  recoveryCases RecoveryCase[]
  promisesToPay PromiseToPay[]

  @@index([merchantId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
}

model RecoveryCase {
  id                  String             @id @default(uuid())
  merchantId          String
  customerId          String?
  paymentId           String?
  invoiceId           String?
  orderId             String?
  subscriptionId      String?
  mandateId           String?
  batchId             String?
  status              RecoveryCaseStatus @default(OPEN)
  riskLevel           RiskLevel?
  revenueAtRisk       Decimal            @db.Decimal(18, 2)
  recoveryProbability Decimal?           @db.Decimal(5, 4)
  rootCause           String?
  aiReasoning         String?
  openedAt            DateTime           @default(now())
  closedAt            DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  payment      Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  mandate      Mandate?       @relation(fields: [mandateId], references: [id], onDelete: SetNull)
  batch        RecoveryBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  actions       RecoveryAction[]
  outcome       RecoveryOutcome?
  auditLogs     AuditLog[]
  promisesToPay PromiseToPay[]

  @@index([merchantId])
  @@index([customerId])
  @@index([batchId])
  @@index([paymentId])
  @@index([orderId])
  @@index([subscriptionId])
  @@index([mandateId])
  @@index([status])
  @@index([riskLevel])
}

model RecoveryBatch {
  id          String              @id @default(uuid())
  merchantId  String
  status      RecoveryBatchStatus @default(DETECTED)
  totalCases  Int
  createdAt   DateTime            @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  merchant Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cases    RecoveryCase[]

  @@index([merchantId])
  @@index([status])
}

model RecoveryAction {
  id             String               @id @default(uuid())
  recoveryCaseId String
  type           RecoveryActionType
  status         RecoveryActionStatus @default(PENDING)
  reason         String?
  policyDecision PolicyAction?
  attemptedAt    DateTime?
  completedAt    DateTime?
  result         Json?
  createdAt      DateTime             @default(now())

  /// Razorpay Payment Link id (e.g. plink_...) when type is SEND_PAYMENT_LINK.
  /// Lets the payment_link.paid webhook find its way back to this action/case.
  externalReferenceId  String?
  externalReferenceUrl String?

  recoveryCase RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  @@index([recoveryCaseId])
  @@index([status])
  @@index([type])
  @@index([externalReferenceId])
}

model RecoveryOutcome {
  id              String              @id @default(uuid())
  recoveryCaseId  String              @unique
  recoveredAmount Decimal             @db.Decimal(18, 2)
  successful      Boolean
  recoveryMethod  RecoveryActionType?
  recoveredAt     DateTime?
  createdAt       DateTime            @default(now())

  recoveryCase RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
}

model Policy {
  id          String             @id @default(uuid())
  merchantId  String
  name        String
  description String?
  actionType  RecoveryActionType
  decision    PolicyAction
  maxRetries  Int?
  maxContacts Int?
  maxAmount   Decimal?           @db.Decimal(18, 2)
  /// Merchant-configurable minimum gap, in minutes, before this action type
  /// may be retried again — a plain policy setting, not a fixed provider or
  /// regulatory rule. Null means no minimum gap is enforced.
  retryIntervalMinutes Int?
  enabled     Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([actionType])
}

/**
 * A genuine, first-class commitment a real customer made to pay an overdue
 * receivable by a future date — captured by a merchant after speaking with
 * the customer (see PromiseToPayService.create), never predefined/seeded.
 * Verification never trusts the promise itself: PromiseToPaySweepService
 * only ever reads the linked RecoveryCase's own status/outcome — the same
 * real webhook- or markPaid-derived ground truth every other recovery path
 * already relies on — to decide KEPT vs MISSED.
 */
model PromiseToPay {
  id              String        @id @default(uuid())
  merchantId      String
  recoveryCaseId  String
  invoiceId       String
  customerId      String
  promisedAmount  Decimal       @db.Decimal(18, 2)
  promisedDate    DateTime
  status          PromiseStatus @default(PENDING)
  /// How this promise was captured. Always merchant-recorded today — there is
  /// no inbound conversational channel that could auto-capture a promise
  /// from a real customer reply yet (the same honesty convention as the B2B
  /// "Mark Paid" merchant attestation elsewhere).
  source          String        @default("MERCHANT_RECORDED")
  notes           String?
  /// Copied verbatim from the real RecoveryOutcome once the linked case is
  /// verified RECOVERED — never independently computed, so this can never
  /// diverge from (or fabricate ahead of) the real provider-confirmed amount.
  recoveredAmount Decimal?      @db.Decimal(18, 2)
  resolvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  merchant     Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  recoveryCase RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([recoveryCaseId])
  @@index([invoiceId])
  @@index([status])
  @@index([promisedDate])
}

model AuditLog {
  id             String   @id @default(uuid())
  merchantId     String
  recoveryCaseId String?
  action         String
  actorType      String
  actorId        String?
  details        Json?
  createdAt      DateTime @default(now())

  merchant     Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  recoveryCase RecoveryCase? @relation(fields: [recoveryCaseId], references: [id], onDelete: SetNull)

  @@index([merchantId])
  @@index([recoveryCaseId])
  @@index([createdAt])
}
